<Window x:Class="scancode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Scan Pro"
        Height="720" Width="1100"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <Window.Resources>

        <!-- Hiệu ứng nhấp nháy -->
        <Storyboard x:Key="BlinkStoryboard"
                    RepeatBehavior="2x"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0.3"
                Duration="0:0:0.4"/>
            <ColorAnimation
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                From="#ffffff"
                To="#0040FF"
                Duration="0:0:0.5"/>


        </Storyboard>

        <Storyboard x:Key="ScanAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="(Canvas.Top)"
                             From="18" To="110" Duration="0:0:1.8"/>
            <DoubleAnimation Storyboard.TargetName="ScanGlow"
                             Storyboard.TargetProperty="(Canvas.Top)"
                             From="6"  To="98"  Duration="0:0:1.8"/>
        </Storyboard>

        <SolidColorBrush x:Key="BgBase"      Color="#F5F6FA"/>
        <SolidColorBrush x:Key="BgWhite"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgLight"     Color="#F8F9FC"/>
        <SolidColorBrush x:Key="Accent"      Color="#4F6EF7"/>
        <SolidColorBrush x:Key="AccentLight" Color="#EEF0FE"/>
        <SolidColorBrush x:Key="Border"      Color="#E2E5EF"/>
        <SolidColorBrush x:Key="TxtPrimary"  Color="#1A1D2E"/>
        <SolidColorBrush x:Key="TxtSub"      Color="#6B7280"/>
        <SolidColorBrush x:Key="TxtMuted"    Color="#B0B8CC"/>
        <SolidColorBrush x:Key="Green"       Color="#22C55E"/>
        <SolidColorBrush x:Key="GreenDark"   Color="#16A34A"/>
        <SolidColorBrush x:Key="Red"         Color="#EF4444"/>
        <SolidColorBrush x:Key="Amber"       Color="#D97706"/>

        <Style x:Key="CboOut" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource TxtSub}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6,28,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="BgBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"/>

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <ToggleButton x:Name="ToggleButton"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  HorizontalAlignment="Right"
                                  Width="26">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="{StaticResource TxtMuted}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TxtPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                              SnapsToDevicePixels="True"
                              MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                    Background="{StaticResource BgWhite}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.08" Color="#1A1D2E"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#F0F2F8"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BgBorder" Property="Background" Value="{StaticResource BgLight}"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="4"
                        Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="Foreground"  Value="{StaticResource TxtPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Foreground"             Value="{StaticResource TxtSub}"/>
            <Setter Property="FontFamily"             Value="Segoe UI"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="Padding"                Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BtnOut" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgWhite}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtSub}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EAF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPri" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5CE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnConfirm" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="0,11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5CE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnReset" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgLight}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtSub}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="16,11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EAF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background"      Value="#FFF0F0"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground"      Value="{StaticResource Red}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Width"     Value="40"/>
            <Setter Property="Height"    Value="21"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#D0D4E8"/>
                            <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.2"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Move" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Move"
                                                             Storyboard.TargetProperty="X"
                                                             To="19" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Move"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgWhite}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F2F8"/>
            <Setter Property="RowBackground"            Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFF"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="{StaticResource TxtPrimary}"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="ColumnHeaderHeight"       Value="34"/>
            <Setter Property="RowHeight"                Value="44"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected"  Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtMuted}"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
        </Style>

        <Style TargetType="ScrollBar">
            <!--<Width>5</Width>-->
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ScanAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1.5" ClipToBounds="True">
        <Grid Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgWhite}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1.5"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
                            <TextBlock Text="▦" FontSize="14" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Scale Scan Pro - IT PRO" FontSize="14" FontWeight="Bold"
                                    Foreground="{StaticResource TxtPrimary}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="15" Background="{StaticResource Border}" Margin="10,0"/>
                        <TextBlock Text="Cân kí theo PO — Quét tự động nền"
                                   FontSize="12" Foreground="{StaticResource TxtMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#EDF7F0" BorderBrush="#B6E8C8" BorderThickness="1"
                            CornerRadius="20" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Green}"
                                     VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="5" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtStatus" Text="Đang chạy — Camera sẵn sàng"
                                       FontSize="12" Foreground="#16A34A" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnOut}" Width="40" Height="40" Margin="2,0"
                                Content="─" FontSize="12" Click="BtnMinimize_Click"/>
                        <Button Style="{StaticResource BtnOut}" Width="40" Height="40" Margin="2,0"
                                Content="□" FontSize="12" Click="BtnMaximize_Click"/>
                        <Button Style="{StaticResource BtnOut}" Width="40" Height="40" Margin="2,0"
                                Content="✕" FontSize="12" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgWhite}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,1.5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,12,10,0">
                            <TextBlock Text="CHÍNH" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TxtMuted}" Margin="10,0,0,6"/>

                            <Button x:Name="nav_dasboard" Style="{StaticResource NavBtnActive}" Margin="0,1" Click="nav_dasboard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="14" Width="22"/>
                                    <TextBlock Text="Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="nav_maneger_po" Click="nav_maneger_po_Click" Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="13" Width="22"/>
                                    <TextBlock Text="Quản lý PO"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="nav_history_scale" Click="nav_history_scale_Click" Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☰" FontSize="14" Width="22"/>
                                    <TextBlock Text="Lịch sử cân"/>
                                </StackPanel>
                            </Button>
                            
                            <!--<Button Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="13" Width="22"/>
                                    <TextBlock Text="Báo cáo"/>
                                </StackPanel>
                            </Button>-->
                            <Button x:Name="nav_export_csv" Click="nav_export_csv_Click" Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑" FontSize="14" Width="22"/>
                                    <TextBlock Text="Xuất Excel"/>
                                </StackPanel>
                            </Button>

                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

                            <TextBlock Text="HỆ THỐNG" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TxtMuted}" Margin="10,0,0,6"/>

                            <Button Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="14" Width="22"/>
                                    <TextBlock Text="Cài đặt cân"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎" FontSize="14" Width="22"/>
                                    <TextBlock Text="Thiết bị"/>
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}"
                                             VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavBtn}" Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔" FontSize="13" Width="22"/>
                                    <TextBlock Text="Thông báo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="12,0,12,14"
                                Background="{StaticResource BgLight}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
