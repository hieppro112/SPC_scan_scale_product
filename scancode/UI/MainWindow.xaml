                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Trái: tổng bản ghi -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Hiển thị " FontSize="12" Foreground="{StaticResource TxtMuted}"/>
                                            <TextBlock x:Name="TxtPageFrom" Text="{Binding Curren_index_item}" FontSize="12"
                       FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock Text=" – " FontSize="12" Foreground="{StaticResource TxtMuted}"/>
                                            <TextBlock x:Name="TxtPageTo" Text="{Binding To_index_item}" FontSize="12"
                       FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock Text=" trên " FontSize="12" Foreground="{StaticResource TxtMuted}"/>
                                            <!--<TextBlock x:Name="TxtPageTotal" Text="{Binding totalList}" FontSize="12"
                       FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>-->
                                            <TextBlock Text="{Binding totalPage}" FontSize="12" Foreground="{StaticResource TxtMuted}"/>
                                        </StackPanel>
                                        <!-- Giữa: các nút trang -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                                            <!-- Trang đầu -->
                                            <Button x:Name="BtnFirstPage" Width="32" Height="32" Margin="2,0"
                    ToolTip="Trang đầu" Click="BtnFirstPage_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{StaticResource BgWhite}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1.5">
                                                            <TextBlock Text="«" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TxtSub}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Trang trước -->
                                            <Button x:Name="BtnPrevPage" Width="32" Height="32" Margin="2,0" IsEnabled="{Binding SttBtn_prev}"
                                                ToolTip="Trang trước" Click="BtnPrevPage_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="7"
                                                                Background="{StaticResource BgWhite}"
                                                                BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1.5">
                                                            <TextBlock Text="‹" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{StaticResource TxtSub}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/> 
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock  Text="{Binding currentPage}" FontSize="12"
                                                    FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}"/>
                                                <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource TxtMuted}"/>
                                                <TextBlock  Text="{Binding sluong_page}" FontSize="12"
                                                    FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>


                                            <!-- Trang sau -->
                                            <Button x:Name="BtnNextPage" Width="32" Height="32" Margin="2,0" IsEnabled="{Binding SttBtn_next}"
                    ToolTip="Trang sau" Click="BtnNextPage_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{StaticResource BgWhite}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1.5">
                                                            <TextBlock Text="›" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TxtSub}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Trang cuối cùng -->
                                            <Button x:Name="BtnLastPage" Width="32" Height="32" Margin="2,0"
                    ToolTip="Trang cuối" Click="BtnLastPage_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{StaticResource BgWhite}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1.5">
                                                            <TextBlock Text="»" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TxtSub}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Phải: chọn số dòng/trang -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Hiển thị" FontSize="12"
                       Foreground="{StaticResource TxtMuted}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CmbPageSize"
                                                  Width="70" Height="30"
                                                  FontSize="12"
                                                  SelectedIndex="0"
                                                  SelectionChanged="CmbPageSize_SelectionChanged">      
                                                <ComboBoxItem Content="5"/>
                                                <ComboBoxItem Content="10"/>
                                                <ComboBoxItem Content="15"/>
                                                <ComboBoxItem Content="20"/>
                                            </ComboBox>
                                            <TextBlock Text=" dòng/trang" FontSize="12"
                                               Foreground="{StaticResource TxtMuted}"
                                               VerticalAlignment="Center"/>     
                                        </StackPanel>
                                    </Grid>
                                </Border>



                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource BgWhite}" BorderBrush="{StaticResource Border}" BorderThickness="0,1.5,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="Phiên bản chuyên nghiệp v1.0.0" FontSize="11" Foreground="{StaticResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="Hệ thống cân tự động kết nối Camera thông minh" FontSize="11" Foreground="{StaticResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>