<Window x:Class="scancode.UI.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Scan — thu nhỏ"
        Width="220" Height="170"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border CornerRadius="12" Background="#1A1D2E"
            BorderBrush="#3A3F55" BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid ClipToBounds="True">
            <Image x:Name="MiniCamera" Stretch="Uniform"/>

            <Grid VerticalAlignment="Top" Height="24" Background="#59000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Scale Scan — thu nhỏ" Foreground="White" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button x:Name="BtnRestore" Grid.Column="1" Content="⤢" Width="24" Height="24"
                        Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12"
                        Cursor="Hand" ToolTip="Phóng to lại" Click="BtnRestore_Click"/>
            </Grid>

            <Border x:Name="ToastPanel" VerticalAlignment="Bottom" Background="#DD16A34A"
                    Padding="10,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✓ " Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtToast" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
